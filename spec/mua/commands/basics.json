      "expect": {
        "commands": [
          {
            "verb": "unlock",
            "target": "door",
            "indirect": "iron_key"
          }
        ]
      }
    },
    {
      "name": "say keeps the text as typed",
      "input": "say Hello  there, Bob",
      "expect": {
        "commands": [
          {
            "verb": "say",
            "text": "Hello  there, Bob"
          }
        ]
      }
    },
    {
      "name": "a leading quote says the rest",
      "input": "'Hi all",
      "expect": {
        "commands": [
          {
            "verb": "say",
            "text": "Hi all"
          }
        ]
      }
    },
    {
      "name": "say to someone in the room",
      "input": "say to bob hi",
      "expect": {
        "commands": [
          {
            "verb": "sayTo",
            "target": "bob",
            "text": "hi"
          }
        ]
      }
    },
    {
      "name": "a listener's name says to them",
      "input": "bob hello",
      "expect": {
        "commands": [
          {
            "verb": "sayTo",
            "target": "bob",
            "text": "hello"
          }
        ]
      }
