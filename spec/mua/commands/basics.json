{
  "edl": "house.edl",
  "actor": "ada",
  "cases": [
    {
      "name": "look on its own",
      "input": "look",
      "expect": {
        "commands": [
          {
            "verb": "look"
          }
        ]
      }
    },
    {
      "name": "look around",
      "input": "look around",
      "expect": {
        "commands": [
          {
            "verb": "look"
          }
        ]
      }
    },
    {
      "name": "look at a thing, dropping an article",
      "input": "look at the lamp",
      "expect": {
        "commands": [
          {
            "verb": "examine",
            "target": "lamp"
          }
        ]
      }
    },
    {
      "name": "look in a thing",
      "input": "look in box",
      "expect": {
        "commands": [
          {
            "verb": "examine",
            "target": "box"
          }
        ]
      }
    },
    {
      "name": "an Alias of look with a noun",
      "input": "x lantern",
      "expect": {
        "commands": [
          {
            "verb": "examine",
            "target": "lamp"
          }
        ]
      }
    },
    {
      "name": "go in a Direction",
      "input": "go north",
      "expect": {
        "commands": [
          {
            "verb": "move",
            "direction": "north"
          }
        ]
      }
    },
    {
      "name": "go to a Direction",
      "input": "walk to north",
      "expect": {
        "commands": [
          {
            "verb": "move",
            "direction": "north"
          }
        ]
      }
    },
    {
      "name": "a Direction on its own",
      "input": "south",
      "expect": {
        "commands": [
          {
            "verb": "move",
            "direction": "south"
          }
        ]
      }
    },
    {
      "name": "a Direction's Alias",
      "input": "ne",
      "expect": {
        "commands": [
          {
            "verb": "move",
            "direction": "northeast"
          }
        ]
      }
    },
    {
      "name": "go without a Direction",
      "input": "go",
      "expect": {
        "reply": "Where do you want to go?"
      }
    },
    {
      "name": "go somewhere that is no Direction",
      "input": "go banana",
      "expect": {
        "reply": "Where do you want to go?"
      }
    },
