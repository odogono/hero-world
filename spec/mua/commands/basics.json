      "input": "take key",
      "expect": {
        "reply": "Which do you mean: the iron key or the brass key?"
      }
    },
    {
      "name": "the reply to which do you mean",
      "input": ["take key", "brass"],
      "expect": {
        "commands": [
          {
            "verb": "take",
            "target": "brass_key"
          }
        ]
      }
    },
    {
      "name": "again repeats the last input",
      "input": ["take lamp", "g"],
