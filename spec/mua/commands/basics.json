    {
      "name": "say nothing",
      "input": "say",
      "expect": {
        "reply": "What do you want to say?"
      }
    },
    {
      "name": "an unknown word",
      "input": "dance",
      "expect": {
        "reply": "Unknown command: \"dance\""
      }
    },
    {
      "name": "nothing typed",
      "input": "   ",
      "expect": {
        "reply": "Please enter a command."
      }
    },
