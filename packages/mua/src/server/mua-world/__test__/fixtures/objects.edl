# A small world for testing how players refer to objects

atom room {
  container { capacity: 100 is_closed: false }
  described { name: "Room" description: "A room." }
}

atom item {
  item { weight: 1 is_takeable: true }
}

atom box {
  container { capacity: 5 is_closed: false }
}

entity west_of_house : room {
  meta { props: { id: "west_of_house" } }
  described { name: "Workshop" description: "A cluttered workshop." }
}

entity brass_key : item {
  described { name: "Brass key" description: "A small brass key." }
  noun { words: ["key"] }
  location { in: $west_of_house }
}

entity iron_key : item {
  described { name: "Iron key" description: "A heavy iron key." }
  noun { words: ["key"] }
  location { in: $west_of_house }
}

entity lamp : item {
  described { name: "Lamp" description: "A brass oil lamp." }
  noun { words: ["light", "lantern"] }
  location { in: $west_of_house }
}

entity crate : box {
  described { name: "Crate" description: "A wooden crate." }
  container { is_closed: true }
  location { in: $west_of_house }
}

entity coin : item {
  described { name: "Coin" description: "A gold coin." }
  location { in: $crate }
}

entity anvil {
  described { name: "Anvil" description: "A very heavy anvil." }
  location { in: $west_of_house }
}

# ==========
# Responses: fixed replies that refuse a command
# ==========

atom exit {
}

atom bolted {
  responses { target: { take: "It's bolted to the floor." } }
}

entity statue : item bolted {
  described { name: "Statue" description: "A marble statue." }
  location { in: $west_of_house }
}

entity plinth {
  described { name: "Plinth" description: "A stone plinth." }
  responses { indirect: { open: "The plinth is not a key." } }
  location { in: $west_of_house }
}

entity vault : room {
  described { name: "Vault" description: "A silent stone vault." }
  responses { room: { drop: "The floor is too sacred to drop things on.", say: "The silence swallows your words." } }
}

entity workshop_east : exit {
  location { in: $west_of_house } portal { dir: "east" to: $vault }
}

# Messages that replace the built-in defaults, set directly or inherited
atom fragile {
  messages { omsg: { drop: "{actor} sets {the target} down very gently." } }
}

entity vase : item fragile {
  described { name: "Vase" description: "A thin porcelain vase." }
  messages { msg: { take: "You lift {the target} with both hands." } }
  location { in: $west_of_house }
}

entity trapdoor : exit {
  location { in: $vault } portal { dir: "down" to: $west_of_house }
  messages {
    msg: { move: "You drop through the trapdoor." }
    omsg: { move: "{actor} vanishes through the trapdoor.", arrive: "{actor} tumbles out of the ceiling." }
  }
}
