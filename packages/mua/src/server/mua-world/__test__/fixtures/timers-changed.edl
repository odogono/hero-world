# timers.edl after an edit, for migrations: a garden north of the hall,
# the belfry no longer chimes, and the lamp is described afresh

atom room {
  container { capacity: 100 is_closed: false }
}

atom item {
  item { weight: 1 is_takeable: true }
}

# Chimes on a timer, and lights its candles a while after the world starts
atom belfry {
  script { src: "scripts/belfry.talk" }
}

entity west_of_house : room belfry {
  meta { props: { id: "west_of_house" } }
  described { name: "Belfry" description: "A bell hangs overhead." }
  exits { east: $hall }
  timers { every: { reset: 60 } }
}

entity hall : room {
  described { name: "Hall" description: "A long hall." }
  exits { north: $garden }
}

entity garden : room {
  described { name: "Garden" description: "Roses grow along the wall." }
}

entity lamp : item {
  described { name: "Lamp" description: "A dented brass lamp." }
  location { in: $west_of_house }
}
