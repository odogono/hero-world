# A small world for Limbo, the system actor and lifecycle messages

atom room {
  container { capacity: 100 is_closed: false }
}

atom item {
  item { weight: 1 is_takeable: true }
}

# Settles its dust when reset
atom dusty {
  script { src: "scripts/dusty.talk" }
}

# Gets heavier as the world starts
atom waking {
  script { src: "scripts/waking.talk" }
}

entity west_of_house : room dusty {
  meta { props: { id: "west_of_house" } }
  described { name: "Shrine" description: "A dusty shrine." }
  exits { east: $hall }
}

entity hall : room {
  described { name: "Hall" description: "A long hall." }
}

entity lamp : item {
  described { name: "Lamp" description: "A brass lamp." }
  location { in: $west_of_house }
}

entity idol : item waking {
  described { name: "Idol" description: "A stone idol." }
  location { in: $west_of_house }
}
