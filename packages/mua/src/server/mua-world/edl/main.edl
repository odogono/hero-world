



# ======
# Connection
# ======


# ======
# Atoms
# ======

atom root {
}


# Base container atom (reusable defaults)
atom container {
  meta { props: { id: "container" } }
  container { capacity: 10 is_closed: false }
}

# Room atom (conceptually inherits container via entity-level extension)
atom room: container {
  # Provide defaults; entities will override name/description
  described { name: "Room" description: "An unremarkable room." }
}

# Exit atom: `traverse` moves an actor through its portal
atom exit {
  script { src: "scripts/exit.talk" }
}

# Door atom: an exit that vetoes `beforeTraverse` while it is locked
atom door: exit {
  door { is_locked: true }
  script { src: "scripts/door.talk" }
}

# Generic item atom
atom item {
  meta { props: { id: "item atom" } }
  item { weight: 1 is_takeable: true }
}



# ==========
# World Map
# ==========

entity west_of_house : room {
  meta { props: { id: "west_of_house" } }
  described {
    name: "West of house"
    description: "This is an open field west of a white house, with a boarded front door."
  }
}


entity north_of_house : room {
  meta { props: { id: "north_of_house" } }
  described {
    name: "North of house"
    description: "You are facing the north side of a white house.  There is no door here, and all the windows are barred."
  }
}

entity south_of_house : room {
  meta { props: { id: "south_of_house" } }
  described {
    name: "South of House"
    description: "You are facing the south side of a white house.  There is no door here, and all the windows are barred."
  }
}

entity behind_house : room {
  meta { props: { id: "behind_house" } }
  described {
    name: "Behind House"
    description: "You are behind the white house.  In one corner of the house there is a small window which is slightly ajar."
  }
}

# !set $behind_house.mua.id "behind_house"

entity west_of_house_north : exit {  
  location { in: $west_of_house } portal { dir: "north" to: $north_of_house } }
entity west_of_house_south : exit {  
  location { in: $west_of_house } portal { dir: "south" to: $south_of_house } }

entity north_of_house_east : exit {  
  location { in: $north_of_house } portal { dir: "east" to: $behind_house } }
entity north_of_house_south : exit {  
  location { in: $north_of_house } portal { dir: "south" msg: "The windows are all barred" } }

entity south_of_house_west : exit {  
  location { in: $south_of_house } portal { dir: "west" to: $west_of_house } }
entity south_of_house_east : exit {  
  location { in: $south_of_house } portal { dir: "east" to: $behind_house } }
entity south_of_house_north : exit {  
  location { in: $south_of_house } portal { dir: "north" msg: "The windows are all barred" } }


entity behind_house_west : door {
  location { in: $behind_house } portal { dir: "west" msg: "The window is closed" } }
entity behind_house_north : exit {  
  location { in: $behind_house } portal { dir: "north" to: $north_of_house } }
entity behind_house_south : exit {  
  location { in: $behind_house } portal { dir: "south" to: $south_of_house } }


# ==========
# Items
# ==========


entity mailbox: container {
  described { name: "Mailbox" description: "A small mailbox on a wooden post." }
  container { capacity: 5 is_closed: true }
  location { in: $west_of_house }
}

entity leaflet: item {
  described { name: "Leaflet" description: "A leaflet with bold letters: 'WELCOME TO MUA'" }
  item { weight: 1 }
  location { in: $mailbox }
}
