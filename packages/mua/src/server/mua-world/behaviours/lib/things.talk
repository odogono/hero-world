-- things: helpers for behaviour Scripts, loaded by mua as a Library.
-- Import what you need: `use nameOf, actorName, fits from things`.

-- a thing's name in lower case, for "the strongbox"
function nameOf thing
  return lower(the name of the described of thing)
end nameOf

-- what to call someone who acts: a player's name, else the thing's own
function actorName actor
  if the player of actor is nothing then
    return the name of the described of actor
  end if
  return the name of the player of actor
end actorName

-- does this thing, if it is a key, open the named lock?
function fits candidate, lockName
  if the key of candidate is nothing then
    return false
  end if
  return lockName is in the opens of the key of candidate
end fits
