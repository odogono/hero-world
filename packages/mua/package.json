{
  "name": "mua",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "server": "bun run --hot src/server/index.ts",
    "tui": "bun run --hot src/tui/index.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "unused": "knip"
  },
  "peerDependencies": {
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.1.23",
    "@opentui/react": "^0.1.23",
    "elysia": "^1.3.21",
    "odgn-ecs": "workspace:*",
    "odgn-helpers": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "ws": "^8.18.3"
  }
}