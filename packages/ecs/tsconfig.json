{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Paths
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@component": [
        "./src/component"
      ],
      "@entity": [
        "./src/entity"
      ],
      "@events": [
        "./src/events"
      ],
      "@events/*": [
        "./src/events/*"
      ],
      "@helpers/*": [
        "./src/helpers/*"
      ],
      "@schema": [
        "./src/schema"
      ],
      "@schema/*": [
        "./src/schema/*"
      ],
      "@system": [
        "./src/system/index.ts"
      ],
      "@system/*": [
        "./src/system/*"
      ],
      "@types": [
        "./src/types"
      ],
      "@world": [
        "./src/world"
      ]
    }
  }
}