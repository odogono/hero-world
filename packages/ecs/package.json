{
  "name": "odgn-ecs",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./component": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./edl": "./src/edl/index.ts",
    "./entity": "./src/entity/index.ts",
    "./events": "./src/events/index.ts",
    "./system": "./src/system/index.ts",
    "./world": "./src/world/index.ts",
    "./types": "./src/types.ts"
  },
  "devDependencies": {
    "vite-tsconfig-paths": "^6.1.1",
    "odgn-helpers": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^6",
    "zod": "^4"
  },
  "scripts": {
    "coverage": "bun test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "bun run scripts/generate-schemas.ts",
    "generate:edl": "bun run scripts/generate-edl-parser.ts",
    "generate:help": "bun run scripts/generate-schemas.ts --help",
    "generate:cdef": "bun run scripts/generate-from-cdef.ts",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "unused": "knip"
  },
  "dependencies": {
    "mitt": "^3.0.1",
    "odgn-helpers": "workspace:*",
    "peggy": "^5.1.1",
    "ts-pegjs": "^4.2.3"
  }
}
