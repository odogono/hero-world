{
  "name": "odgn-ecs",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./component": "./src/component.ts",
    "./entity": "./src/entity.ts",
    "./events": "./src/events/index.ts",
    "./system": "./src/system/index.ts",
    "./world": "./src/world.ts"
  },
  "devDependencies": {
    "vite-tsconfig-paths": "^5.1.4",
    "odgn-helpers": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5",
    "zod": "^4"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "bun run scripts/generate-schemas.ts",
    "generate:edl": "bun run scripts/generate-edl-parser.ts",
    "generate:help": "bun run scripts/generate-schemas.ts --help",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "unused": "knip"
  },
  "dependencies": {
    "alasql": "^4.6.6",
    "mitt": "^3.0.1",
    "odgn-helpers": "workspace:*",
    "peggy": "^5.0.6",
    "ts-pegjs": "^4.2.1"
  }
}
