# The environment of the release container (docker run --env-file). Copy it
# outside the checkout, chmod 600, and never commit the copy. Every variable
# is described in packages/mua_server/README.md#configuration;
# rel/deploy-almere.sh writes this file for you.
PHX_HOST=almere.example.ts.net
SECRET_KEY_BASE=          # openssl rand -base64 48
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MUA_STARTING_ROOM=harbour_steps
MUA_ALLOWLIST=you@example.com,your-second@example.com
MUA_ADMINS=you@example.com
