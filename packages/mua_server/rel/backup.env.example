# Settings for rel/backup.sh when the mua-backup timer runs it. Copy to
# ~/mua/backup.env and chmod 600. See docs/operations.md#scheduled-backups.
MUA_CHECKOUT=/home/you/hero-world
# rsync:[user@]host:/path, rsync:/path, or rclone:remote:path
BACKUP_DEST=rsync:you@nas:/backups/mua
KEEP=28
LOCAL_KEEP=2
CONTAINER=mua
# Run when a backup fails, with the reason on stdin. For example:
# ON_FAILURE=curl -fsS --data-binary @- https://ntfy.sh/your-topic
