-- rooms: what someone sees of a place, shared by the room and exit
-- Services. Import what you need: `use describe, isClosed from rooms`.

use join from text
use map, filter from list

-- things as "the mailbox, the leaflet"
function theNames things
  return join(map(things, given t: "the " & lower(the name of the described of t)), ", ")
end theNames

-- whether something that opens and closes (a container or a door) is closed
function isClosed thing
  if thing is nothing then
    return false
  end if
  if the container of thing is not nothing then
    return the is_closed of the container of thing
  end if
  if the door of thing is not nothing then
    return the is_closed of the door of thing
  end if
  return false
end isClosed

-- an exit's direction, marked when its door is closed
function wayName way
  put the dir of the portal of way into dir
  if the door of the portal of way is nothing then
    return dir
  end if
  if isClosed(the door of the portal of way) then
    return dir & " (closed)"
  end if
  return dir
end wayName

-- a place as the actor sees it: its name and description, then what is
-- there, who else is there and the ways out
function describe place, actor
  if the described of place is nothing then
    return "You are in darkness."
  end if
  ask world to find place, "described"
  put every item of it whose portal is nothing into things
  put every item of things whose container is not nothing into containers
  put every item of things whose item is not nothing and it's container is nothing into items

  ask world to find place, "player"
  put map(filter(it, given p: p is not actor), given p: the name of the player of p) into people
  ask world to find place, "npc"
  put filter(it, given n: n is not actor and the described of n is not nothing) into npcs
  put [...people, ...map(npcs, given n: the name of the described of n)] into people

  ask world to find place, "portal"
  put map(it, given w: wayName(w)) into ways

  put [] into lines
  if items is not empty then
    put "You see: " & theNames(items) after lines
  end if
  if containers is not empty then
    put "There is: " & theNames(containers) after lines
  end if
  if people is not empty then
    put "Also here: " & join(people, ", ") after lines
  end if
  if ways is not empty then
    put "Exits: " & join(ways, ", ") after lines
  end if

  put the name of the described of place & `\n` & the description of the described of place into text
  if lines is empty then
    return text
  end if
  return text & `\n\n` & join(lines, `\n`)
end describe
