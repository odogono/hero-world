-- The speech Service: `say` and `say to`, as a Script. mua sends
-- `say target, actor, text` for `say hello`, with Nothing for the target,
-- and `sayTo target, actor, text` for `say to bob hello`. The things in the
-- room hear `heard actor, text`.

use called from messages

on say target, actor, words
  if words is nothing or words is "" then
    return {refused: "What do you want to say?"}
  end if
  if the location of actor is nothing then
    return {refused: "There is nobody here to hear you."}
  end if
  ask world to resolve the in of the location of actor
  put it into here
  tell mua to announce here, `${called(actor)} says, "${words}"`, actor
  tell mua to notice here, "heard", actor, words
  return `You say, "${words}"`
end say

on sayTo target, actor, words
  if target is nothing or (the player of target is nothing and the npc of target is nothing) then
    return {refused: "They can't hear you."}
  end if
  if target is actor then
    return {refused: "You mutter to yourself."}
  end if
  if words is nothing or words is "" then
    return {refused: "What do you want to say?"}
  end if
  put called(target) into name
  if the location of actor is not nothing then
    ask world to resolve the in of the location of actor
    put it into here
    tell mua to announce here, `${called(actor)} says to ${name}, "${words}"`, actor
    tell mua to notice here, "heard", actor, words
  end if
  return `You say to ${name}, "${words}"`
end sayTo
