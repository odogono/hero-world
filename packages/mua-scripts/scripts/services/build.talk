-- The build Service: placing a thing a builder composed (#258), as a
-- Script. mua makes an empty entity, `thing`, then sends
-- `place thing, composition, actor`, where `composition` is a map of
-- component names to their data, such as
--
--   {described: {name: "Satchel", description: "A leather satchel."},
--    item: {}, container: {capacity: 5}}
--
-- It returns `{message, placed, max_placed, suggestions}` when the thing
-- stands in the actor's room, `suggestions` being the Commands the message
-- offers the actor (#275), or `{refused: text}` when it said no. mua keeps nothing of
-- a refusal, the empty entity included.
--
-- An Account builds only if it has a `builder` component, which holds its
-- permissions and limits. The thing records its Maker in `made_by`.
--
-- Editing a placed thing (#274) takes two messages. The `edit` Verb sends
-- `edit target, actor`, which opens the thing in the actor's composer by
-- giving the actor `editing`. Saving sends `save thing, patch, current,
-- actor`: `current` is the thing's composition as it stands, and `patch`
-- is `{put: {name: {property: value}}, remove: [name]}`, the components
-- and properties to change. Both reply text, or `{refused: text}`. mua
-- keeps nothing of a refused save.
--
-- A save, and the Composer's own store and destroy, come from the
-- Composer, not a typed Command, so no Veto sees them (ADR 0028). Each
-- needs the thing open in the actor's Composer and within their Reach,
-- which this Script checks: the Composer's store and destroy send
-- `putAway thing, verb, actor`, `verb` being "store" or "destroy", and
-- reply `{message, placed, max_placed}` as `place` does.
--
-- Destroying a placed thing (#283): the `destroy` Verb sends
-- `destroy target, actor`, which takes away every component the thing
-- has, `made_by` included, so its place in its Maker's quota is free. It
-- replies text, or `{refused: text}`.
--
-- Storing a placed thing (#282): the `store` Verb sends `store target,
-- actor`, which moves the thing, and what it holds, to Limbo. It keeps
-- `made_by`, so it still counts against its Maker's quota. `stored target,
-- actor` lists the stored things the actor may bring back, and `unstore
-- target, actor, words` brings the one `words` names to the actor's room.
-- Each replies text, or `{refused: text}`.

use theName, messageFor, capitalised from messages
use nameOf from things
use theNames from rooms
use join, split, trim from text
use filter from list
use merge, without, withPath from map

-- why `composition` can't be built by an Account with `builder`, or Nothing.
-- What a builder may compose is World data: the components whose
-- definitions are marked `buildable`.
function refusal composition, builder
  if kindOf(composition) is not "map" then
    return "A composition is a map of components."
  end if
  ask mua to buildable into buildable
  repeat for each name in the keys of composition
    if name is not in buildable then
      return `You can't build with ${name}: only ${join(buildable, ", ")}.`
    end if
    if kindOf(the (name) of composition) is not "map" then
      return `The ${name} must be a map of its properties.`
    end if
  end repeat

  put the optional described of composition into described
  if described is nothing then
    return "A thing needs a described, with its name."
  end if
  put the optional name of described into name
  if kindOf(name) is not "text" or the length of trim(name) is 0 then
    return "A thing needs a name."
  end if
  if the length of name > 40 then
    return "A name can be at most 40 characters."
  end if
  put the optional description of described into description
  if description is not nothing and kindOf(description) is "text" then
    if the length of description > 500 then
      return "A description can be at most 500 characters."
    end if
  end if
  return nothing
end refusal

-- why the thing as written is too big a container, or Nothing. It reads
-- what was written, so a capacity left out counts at its default.
function capacityRefusal thing, builder
  if the container of thing is nothing then
    return nothing
  end if
  if the capacity of the container of thing > the max_capacity of builder then
    return `A container can hold at most ${the max_capacity of builder}.`
  end if
  return nothing
end capacityRefusal

on place thing, composition, actor
  put the optional account of the player of actor into account
  if account is nothing or the builder of account is nothing then
    return {refused: "You can't build."}
  end if
  put the builder of account into builder
  if the place of builder is false then
    return {refused: "You can't place things."}
  end if
  if the location of actor is nothing then
    return {refused: "You are nowhere."}
  end if

  ask mua to placed account into placed
  if placed >= the max_placed of builder then
    return {refused: `You have placed all ${the max_placed of builder} things you may.`}
  end if

  put refusal(composition, builder) into why
  if why is not nothing then
    return {refused: why}
  end if

  repeat for each name in the keys of composition
    change thing, name, the (name) of composition
  end repeat
  put capacityRefusal(thing, builder) into why
  if why is not nothing then
    return {refused: why}
  end if
  change thing, "made_by", {account: account}

  put the in of the location of actor into room
  moveTo thing, room
  put {actor: actor, target: thing} into about
  put messageFor("place", "omsg", about) otherwise `${the name of the player of actor} makes ${theName(thing)}.` into others
  tell mua to announce room, others, actor
  put messageFor("place", "msg", about) otherwise `You make ${theName(thing)}.` into message
  put [`edit ${theName(thing)}`] into suggestions
  return {message: message, placed: placed + 1, max_placed: the max_placed of builder, suggestions: suggestions}
end place

-- why the Account can't `verb` this thing, or Nothing. Only a placed
-- thing, one with a Maker, is edited or destroyed this way. The `builder`
-- permission named `verb` says which: `none`, `own` (what the Account made)
-- or `any`. `done` is the verb's past participle.
function builderRefusal thing, account, verb, done
  if account is nothing or the builder of account is nothing then
    return "You can't build."
  end if
  if the made_by of thing is nothing then
    return `Only a thing someone placed can be ${done}.`
  end if
  put the (verb) of the builder of account into may
  if may is "any" then
    return nothing
  end if
  if may is "own" and the account of the made_by of thing is account then
    return nothing
  end if
  if may is "own" then
    return "You didn't make that."
  end if
  return `You can't ${verb} things.`
end builderRefusal

function editRefusal thing, account
  return builderRefusal(thing, account, "edit", "edited")
end editRefusal

-- whether a Character holds this, directly or inside something they carry
function carried thing, seen
  if the location of thing is nothing then
    return false
  end if
  put the in of the location of thing into holder
  if holder is nothing or holder is in seen then
    return false
  end if
  if the player of holder is not nothing then
    return true
  end if
  return carried(holder, [...seen, thing])
end carried

-- why the thing, as written, would strand what it holds or who holds it,
-- or Nothing. An edit never moves anything to make room.
function strandRefusal thing
  ask world to find thing, "location" into inside
  put the length of inside into held
  if held > 0 and the container of thing is nothing then
    return `${capitalised(theName(thing))} holds things: empty it first.`
  end if
  if the container of thing is not nothing and the capacity of the container of thing < held then
    return `${capitalised(theName(thing))} holds ${held} things: it can't hold fewer.`
  end if
  if the item of thing is nothing and carried(thing, []) then
    return `Someone is carrying ${theName(thing)}: it must stay a thing that can be carried.`
  end if
  return nothing
end strandRefusal

-- `patch` applied to `composition`: its `remove`d components gone, and
-- its `put` properties over the rest. Gives `{composition}`, or
-- `{refused: text}` when the patch can't be read.
function patched composition, patch, buildable
  if kindOf(patch) is not "map" then
    return {refused: "An edit is a map of what to put and remove."}
  end if
  put the optional remove of patch otherwise [] into removes
  put the optional put of patch otherwise {} into puts
  if kindOf(removes) is not "list" or kindOf(puts) is not "map" then
    return {refused: "An edit puts a map of components, and removes a list of them."}
  end if
  repeat for each name in removes
    if name is not in buildable then
      return {refused: `You can't edit ${name}: only ${join(buildable, ", ")}.`}
    end if
    put without(composition, [name]) into composition
  end repeat
  repeat for each name in the keys of puts
    if name is not in buildable then
      return {refused: `You can't edit ${name}: only ${join(buildable, ", ")}.`}
    end if
    put the (name) of puts into changed
    if kindOf(changed) is not "map" then
      return {refused: `The ${name} must be a map of its properties.`}
    end if
    put the optional (name) of composition otherwise {} into was
    put withPath(composition, [name], merge(was, changed)) into composition
  end repeat
  return {composition: composition}
end patched

-- The `edit` Verb: opens a placed thing in the actor's composer
on edit thing, actor
  if thing is nothing then
    return {refused: "What do you want to edit?"}
  end if
  put editRefusal(thing, the optional account of the player of actor) into why
  if why is not nothing then
    return {refused: why}
  end if
  change actor, "editing", {thing: thing}
  return `You open ${theName(thing)} to edit it.`
end edit

-- why the actor can't change `thing` from the Composer, or Nothing: it
-- must be the thing the `edit` Verb opened, and still within Reach, as the
-- Verb found it
function composerRefusal thing, actor
  put the optional editing of actor into editing
  if editing is nothing or the optional thing of editing is not thing then
    return "Open it with edit first."
  end if
  ask mua to reaches actor, thing into reached
  if not reached then
    return "You can't reach that from here."
  end if
  return nothing
end composerRefusal

-- Saving an edit: the thing's components as `patch` changes `current`
on save thing, patch, current, actor
  put composerRefusal(thing, actor) into why
  if why is not nothing then
    return {refused: why}
  end if
  put the optional account of the player of actor into account
  put editRefusal(thing, account) into why
  if why is not nothing then
    return {refused: why}
  end if

  ask mua to buildable into buildable
  put patched(current, patch, buildable) into result
  if the optional refused of result is not nothing then
    return result
  end if
  put the composition of result into composition
  put refusal(composition, nothing) into why
  if why is not nothing then
    return {refused: why}
  end if

  repeat for each name in the keys of current
    if name is not in the keys of composition then
      remove thing, name
    end if
  end repeat
  repeat for each name in the keys of composition
    change thing, name, the (name) of composition
  end repeat

  -- a thing's limits are its Maker's, whoever edits it
  put the optional builder of the account of the made_by of thing otherwise the builder of account into limits
  put capacityRefusal(thing, limits) otherwise strandRefusal(thing) into why
  if why is not nothing then
    return {refused: why}
  end if
  remove actor, "editing"

  put {actor: actor, target: thing} into about
  put messageFor("edit", "omsg", about) otherwise `${the name of the player of actor} reshapes ${theName(thing)}.` into others
  tell mua to announce the in of the location of actor, others, actor
  return messageFor("edit", "msg", about) otherwise `You reshape ${theName(thing)}.`
end save

-- Closes the thing in every composer that has it open
function closeEditors thing
  ask mua to editors thing into editors
  repeat for each character in editors
    remove character, "editing"
  end repeat
end closeEditors

-- Takes away every component a placed thing has, for the `destroy` Verb.
-- It refuses while the thing holds anything, so nothing is lost by
-- accident, and closes it in every composer that has it open. Replies
-- text, or `{refused: text}`.
function destroying thing, actor
  if thing is nothing then
    return {refused: "What do you want to destroy?"}
  end if
  put builderRefusal(thing, the optional account of the player of actor, "destroy", "destroyed") into why
  if why is not nothing then
    return {refused: why}
  end if
  ask world to find thing, "location" into inside
  if the length of inside > 0 then
    return {refused: `${capitalised(theName(thing))} holds things: empty it first.`}
  end if

  -- the thing's name and messages, while it still has them
  put {actor: actor, target: thing} into about
  put messageFor("destroy", "omsg", about) otherwise `${the name of the player of actor} unmakes ${theName(thing)}.` into others
  put messageFor("destroy", "msg", about) otherwise `You unmake ${theName(thing)}.` into message

  closeEditors(thing)
  ask world to destroy thing
  tell mua to announce the in of the location of actor, others, actor
  return message
end destroying

-- The `destroy` Verb
on destroy thing, actor
  return destroying(thing, actor)
end destroy

-- Moves a placed thing to Limbo, with what it holds, for the `store`
-- Verb. Replies text, or `{refused: text}`.
function storing thing, actor
  if thing is nothing then
    return {refused: "What do you want to store?"}
  end if
  put builderRefusal(thing, the optional account of the player of actor, "store", "stored") into why
  if why is not nothing then
    return {refused: why}
  end if

  put {actor: actor, target: thing} into about
  put messageFor("store", "omsg", about) otherwise `${the name of the player of actor} puts away ${theName(thing)}.` into others
  closeEditors(thing)
  ask mua to limbo into limbo
  moveTo thing, limbo
  tell mua to announce the in of the location of actor, others, actor
  return messageFor("store", "msg", about) otherwise `You put away ${theName(thing)}.`
end storing

-- The `store` Verb
on store thing, actor
  return storing(thing, actor)
end store

-- The Composer's store or destroy: as the Verb `verb`, for the thing open
-- in the actor's Composer. Replies `{message, placed, max_placed}`, the
-- actor's Account's count after it, or `{refused: text}`.
on putAway thing, verb, actor
  put composerRefusal(thing, actor) into why
  if why is not nothing then
    return {refused: why}
  end if
  if verb is "store" then
    put storing(thing, actor) into done
  else
    put destroying(thing, actor) into done
  end if
  if kindOf(done) is "map" then
    return done
  end if
  put the account of the player of actor into account
  ask mua to placed account into placed
  return {message: done, placed: placed, max_placed: the max_placed of the builder of account}
end putAway

-- The stored things in Limbo that the Account may bring back, in the
-- order they were made
function storedFor account
  ask mua to limbo into limbo
  ask world to find limbo, "made_by" into things
  return filter(things, given t: builderRefusal(t, account, "store", "stored") is nothing)
end storedFor

-- The words of a name, in lower case, without an article before them
function wordsOf words
  put [] into kept
  repeat for each w in split(lower(trim(words)), " ")
    if w is not "" and not (kept is empty and w is in ["the", "a", "an"]) then
      put [...kept, w] into kept
    end if
  end repeat
  return kept
end wordsOf

-- why an actor can't bring back stored things at all, or Nothing
function unstoreRefusal account
  if account is nothing or the builder of account is nothing then
    return "You can't build."
  end if
  if the store of the builder of account is "none" then
    return "You can't store things."
  end if
  return nothing
end unstoreRefusal

-- The `stored` Verb: lists what the actor may bring back
on stored target, actor
  put the optional account of the player of actor into account
  put unstoreRefusal(account) into why
  if why is not nothing then
    return {refused: why}
  end if
  put storedFor(account) into things
  if things is empty then
    return "You have nothing stored."
  end if
  return `You can bring back ${theNames(things)}.`
end stored

-- The `unstore` Verb: brings the stored thing `words` names to the actor's
-- room. Two stored things with the same name are told apart by a number,
-- in the order `stored` lists them: `unstore satchel 2`.
on unstore target, actor, words
  put the optional account of the player of actor into account
  put unstoreRefusal(account) into why
  if why is not nothing then
    return {refused: why}
  end if
  if words is nothing or the length of wordsOf(words) is 0 then
    return {refused: "What do you want to bring back?"}
  end if
  if the location of actor is nothing then
    return {refused: "You are nowhere."}
  end if

  put storedFor(account) into things
  put wordsOf(words) into parts
  put join(parts, " ") into name
  put filter(things, given t: nameOf(t) is name) into matches
  put nothing into which
  if the length of matches is 0 and the length of parts > 1 then
    -- the last word may be a number that picks one of several
    put item (the length of parts) of parts into last
    put [] into rest
    repeat for each w in parts
      if the length of rest < the length of parts - 1 then
        put [...rest, w] into rest
      end if
    end repeat
    put join(rest, " ") into name
    put filter(things, given t: nameOf(t) is name) into matches
    put 0 into i
    repeat for each t in matches
      put i + 1 into i
      if last is `${i}` then
        put t into which
      end if
    end repeat
    if which is nothing then
      put [] into matches
    end if
  else if the length of matches is 1 then
    put item 1 of matches into which
  end if

  if the length of matches is 0 then
    return {refused: `You have no ${join(parts, " ")} stored.`}
  end if
  if which is nothing then
    return {refused: `You have ${the length of matches} stored called ${name}: say which, from unstore ${name} 1 to unstore ${name} ${the length of matches}.`}
  end if

  put {actor: actor, target: which} into about
  moveTo which, the in of the location of actor
  put messageFor("unstore", "omsg", about) otherwise `${the name of the player of actor} brings out ${theName(which)}.` into others
  tell mua to announce the in of the location of actor, others, actor
  return messageFor("unstore", "msg", about) otherwise `You bring out ${theName(which)}.`
end unstore
