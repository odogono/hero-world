-- The lock Service: `lock` and `unlock`, as a Script. For `unlock box` or
-- `unlock box with key`, mua sends `unlock target, actor` (or `lock …`),
-- and the key named, if any, is the command's `indirect`.
--
-- It returns what the actor sees when it acted, or `{refused: text}` when
-- it said no, so mua neither keeps its changes nor sends `afterUnlock`.
--
-- A thing locks with a `lockable { is_locked: true lock: "chest" }`, and a
-- key opens the locks its `key { opens: [...] }` lists. Whether a locked
-- thing opens is the open Action's question.

use nameOf, fits from things
use messageFor from messages

on unlock target, actor
  if the lockable of target is nothing then
    return {refused: "You can't unlock that."}
  end if
  if not the is_locked of the lockable of target then
    return {refused: `The ${nameOf(target)} is already unlocked.`}
  end if
  return turnKey(target, actor, "unlock", false)
end unlock

on lock target, actor
  if the lockable of target is nothing then
    return {refused: "You can't lock that."}
  end if
  if the is_locked of the lockable of target then
    return {refused: `The ${nameOf(target)} is already locked.`}
  end if
  if isOpen(target) then
    return {refused: `You'll have to close the ${nameOf(target)} first.`}
  end if
  return turnKey(target, actor, "lock", true)
end lock

-- whether a container or door stands open
function isOpen thing
  put the container of thing otherwise the door of thing into data
  return data is not nothing and not the is_closed of data
end isOpen

-- locks or unlocks the target with the key named, or one the actor carries
on turnKey target, actor, verb, locking
  put the lock of the lockable of target into lockName
  ask mua to command into cmd
  put the indirect of cmd into k
  put "" into chosen
  if k is nothing then
    ask world to find actor, "key" into keys
    repeat for each candidate in keys
      if k is nothing and fits(candidate, lockName) then
        put candidate into k
      end if
    end repeat
    if k is nothing then
      return {refused: `You need a key to ${verb} the ${nameOf(target)}.`}
    end if
    put `(with the ${nameOf(k)})\n` into chosen
  else if the key of k is nothing then
    return {refused: `You can't ${verb} anything with that.`}
  else if not fits(k, lockName) then
    return {refused: `The ${nameOf(k)} doesn't fit.`}
  end if

  change target, "lockable", {is_locked: locking, lock: lockName}
  put messageFor(verb, "omsg", {actor: actor, target: target, indirect: k}) into others
  if others is not nothing then
    ask world to resolve the in of the location of actor
    tell mua to announce it, others, actor
  end if
  return chosen & messageFor(verb, "msg", {actor: actor, target: target, indirect: k})
end turnKey
