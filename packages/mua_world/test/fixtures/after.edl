# A small world where Scripts add to the Actions' replies

include "mua-scripts:edl/base.edl"

atom room {
  container { capacity: 100 is_closed: false }
}

atom item {
  item { weight: 1 is_takeable: true }
}

# Hums when looked at
atom humming {
  script { src: "scripts/humming.talk" }
}

# Remarks on anything taken from it
atom dusty_room {
  script { src: "scripts/dusty-room.talk" }
}

entity west_of_house : room dusty_room {
  meta { props: { id: "west_of_house" } }
  described { name: "Attic" description: "A dusty attic." }
}

entity orb : item humming {
  described { name: "Orb" description: "A glass orb." }
  location { in: $west_of_house }
}

entity rock : item {
  described { name: "Rock" description: "A plain rock." }
  location { in: $west_of_house }
}
