# A small world that adds verbs of its own, for its Scripts to handle

atom room {
  container { capacity: 100 is_closed: false }
  script { src: "scripts/plain-room.talk" }
}

atom item {
  item { weight: 1 is_takeable: true }
}

atom holy {
  script { src: "scripts/chapel.talk" }
}

atom hollow {
  script { src: "scripts/table.talk" }
}

entity world_verbs {
  verbs {
    defs: [
      {
        names: ["pray" "kneel"]
        forms: [
          { handler: "prayTo" pattern: "to obj" scope: "room" }
          { handler: "pray" pattern: "" }
        ]
        incomplete: "Pray to whom?"
      }
      {
        names: ["look" "l"]
        forms: [{ handler: "lookUnder" pattern: "under obj" }]
      }
    ]
  }
}

entity west_of_house : room holy {
  meta { props: { id: "west_of_house" } }
  described { name: "Chapel" description: "A small stone chapel." }
  exits { east: $yard }
}

entity yard : room {
  described { name: "Yard" description: "A bare yard." }
}

entity altar : hollow {
  described { name: "Altar" description: "A stone altar." }
  location { in: $west_of_house }
}
