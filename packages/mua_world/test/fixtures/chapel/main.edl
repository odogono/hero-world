# A chapel with a statue, a lever, a candle and a sexton. Tests make Ada, a
# Character, and enter her here.

include "mua-scripts:edl/base.edl"

def pulled {
  yes: boolean
}

def smashed {
  yes: boolean
}

atom thing {}
atom room: thing { script { src: "room.talk" } }
atom chapel_place: room { script { src: "chapel.talk" } }
atom heavy: thing { script { src: "heavy.talk" } }
atom echoing: thing { script { src: "sexton.talk" } }

# The chapel's own verbs, each taking the rest of the input as text
entity chapel_verbs {
  verbs {
    defs: [
      { names: ["pull"] forms: [{ handler: "pull" pattern: "text" }] }
      { names: ["smash"] forms: [{ handler: "smash" pattern: "text" }] }
      { names: ["pray"] forms: [{ handler: "pray" pattern: "text" }] }
      { names: ["ring"] forms: [{ handler: "ring" pattern: "text" }] }
    ]
  }
}

entity chapel: chapel_place {
  described { name: "Chapel" description: "Candles flicker." }
}

entity statue: heavy {
  described { name: "statue" }
  item { is_takeable: true }
  meta { props: { id: "statue" } }
  location { in: $chapel }
}

entity lever: thing {
  described { name: "lever" }
  meta { props: { id: "lever" } }
  location { in: $chapel }
}

entity candle: thing {
  described { name: "candle" }
  item { is_takeable: true }
  meta { props: { id: "candle" } }
  location { in: $chapel }
}

entity sexton: echoing {
  described { name: "Sexton" }
  meta { props: { id: "sexton" } }
  location { in: $chapel }
}
