-- Hollis, the gardener: potters between the orchard and the garden path,
-- greets visitors, and knows where the shed key went.

-- Every NPC's heartbeat (mua's npc_heartbeat System) is a chance to potter
on heartbeat actor
  if the name of the described of the in of the location of the target is "Orchard" then
    tell mua to act the target, "south"
  else
    tell mua to act the target, "north"
  end if
end heartbeat

on arrived who
  if the player of who is not nothing then
    tell mua to act the target, `say Mind the roses, ${the name of the player of who}.`
  end if
end arrived

on heard speaker, words
  if lower(words) contains "key" then
    tell mua to act the target, "say The shed key? I dropped it in the well bucket, I think."
  end if
end heard
