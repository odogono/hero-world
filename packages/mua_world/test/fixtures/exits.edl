# A small map made with the exits shorthand

atom room {
  container { capacity: 100 is_closed: false }
}

atom exit {
}

entity west_of_house : room {
  meta { props: { id: "west_of_house" } }
  described { name: "Hall" description: "A long hall." }
  exits {
    north: $library
    east: { to: $cellar one_way: true }
    west: { msg: "A painted door. It doesn't open." }
  }
}

entity library : room {
  described { name: "Library" description: "Dusty shelves." }
}

entity cellar : room {
  described { name: "Cellar" description: "Damp and dark." }
  exits { up: $west_of_house }
}

entity study : room {
  described { name: "Study" description: "A quiet study." }
  exits { south: $west_of_house }
}

# A declared exit entity wins over one the shorthand would make
entity library_south : exit {
  location { in: $library } portal { dir: "south" msg: "A bookcase blocks the way." }
}
