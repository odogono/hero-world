use nameOf from things

on smell role, actor
  if role is "target" then
    return "A heady, sweet scent. They could do with some water, though."
  end if
  pass smell
end smell

on water role, actor
  if role is not "target" then
    pass water
  end if
  ask mua to command
  put the indirect of it into what
  if nameOf(what) is not "watering can" then
    return `The ${nameOf(what)} won't help the roses.`
  end if
  tell mua to announce the in of the location of actor, `${the name of the player of actor} waters the roses.`, actor
  return "You water the roses. They drink gratefully and lift their heads."
end water
