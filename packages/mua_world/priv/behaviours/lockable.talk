-- Locks and keys, written as a Script: the pilot for writing behaviours in
-- NorthTalk rather than Elixir. It does what MuaWorld.Actions does, so
-- a world can use either; the same tests run against both.
--
-- Put it on an atom with a `lockable` component:
--   atom chest {
--     lockable { is_locked: true lock: "chest" }
--     script { src: "priv/behaviours/lockable.talk" }
--   }

use nameOf, actorName, fits from things

-- a locked thing won't open
on open role, actor
  if role is "target" and the lockable of the target is not nothing then
    if the is_locked of the lockable of the target then
      return `The ${nameOf(the target)} is locked.`
    end if
  end if
  pass open
end open

on unlock role, actor
  if role is not "target" or the lockable of the target is nothing then
    pass unlock
  end if
  if not the is_locked of the lockable of the target then
    return `The ${nameOf(the target)} is already unlocked.`
  end if
  return turnKey("unlock", actor, false)
end unlock

on lock role, actor
  if role is not "target" or the lockable of the target is nothing then
    pass lock
  end if
  if the is_locked of the lockable of the target then
    return `The ${nameOf(the target)} is already locked.`
  end if
  if the container of the target is not nothing then
    if not the is_closed of the container of the target then
      return `You'll have to close the ${nameOf(the target)} first.`
    end if
  end if
  return turnKey("lock", actor, true)
end lock

-- locks or unlocks the target with the key named, or one the actor carries
on turnKey verb, actor, locking
  put the lock of the lockable of the target into lockName
  ask mua to command
  put the indirect of it into k
  put "" into chosen
  if k is nothing then
    ask world to find actor, "key"
    repeat for each candidate in it
      if k is nothing and fits(candidate, lockName) then
        put candidate into k
      end if
    end repeat
    if k is nothing then
      return `You need a key to ${verb} the ${nameOf(the target)}.`
    end if
    put `(with the ${nameOf(k)})\n` into chosen
  else if the key of k is nothing then
    return `You can't ${verb} anything with that.`
  else if not fits(k, lockName) then
    return `The ${nameOf(k)} doesn't fit.`
  end if

  change the target, "lockable", {is_locked: locking, lock: lockName}
  ask mua to message verb, "omsg", k
  put it into others
  ask world to resolve the in of the location of actor
  tell mua to announce it, others, actor
  ask mua to message verb, "msg", k
  return chosen & it
end turnKey
