{
  "name": "vite-react-starter",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "dev:server": "bun --hot src/server/index.ts",
    "start:server": "bun src/server/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "preview": "vite preview",
    "unused": "knip",
    "coverage": "bun test --coverage",
    "test": "bun test",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.30",
    "odgn-ecs": "workspace:*",
    "odgn-helpers": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nkzw/eslint-config": "^3.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "playwright": "^1.64.1",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
