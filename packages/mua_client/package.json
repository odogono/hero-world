{
  "name": "mua-client",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "test": "bun test src",
    "e2e": "bun run build.ts --dev && playwright test"
  },
  "dependencies": {
    "@preact/signals": "^2.3.1",
    "phoenix": "^1.8.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/preact": "^3.2.4",
    "@types/bun": "latest",
    "@types/phoenix": "^1.6.6"
  },
  "peerDependencies": {
    "eslint": "^10",
    "prettier": "^3",
    "typescript": "^6"
  }
}
