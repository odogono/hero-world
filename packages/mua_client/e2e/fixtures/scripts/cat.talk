-- The cat pads in from the kitchen soon after the World starts, whoever is
-- online, then meows now and then. It acts through mua's commands, as a
-- player does.
on start actor
  ask clock to now
  tell timer to schedule "wander", it + 2 s, "wander", []
end start

on wander
  tell mua to act the target, "west"
  ask clock to now
  tell timer to schedule "meow", it + 3 s, "meow", []
end wander

on meow
  tell mua to act the target, "say Meow"
  ask clock to now
  tell timer to schedule "meow", it + 3 s, "meow", []
end meow
