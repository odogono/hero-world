{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    // Paths
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@component": [
        "./src/component"
      ],
      "@entity": [
        "./src/entity"
      ],
      "@events": [
        "./src/events"
      ],
      "@events/*": [
        "./src/events/*"
      ],
      "@helpers/*": [
        "./src/helpers/*"
      ],
      "@schema": [
        "./src/schema"
      ],
      "@schema/*": [
        "./src/schema/*"
      ],
      "@system": [
        "./src/system/index.ts"
      ],
      "@system/*": [
        "./src/system/*"
      ],
      "@types": [
        "./src/types"
      ],
      "@world": [
        "./src/world"
      ]
    }
  }
}